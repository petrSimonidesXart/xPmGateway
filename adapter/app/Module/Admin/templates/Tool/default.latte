{block title}Nástroje{/block}

{block content}
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Popis</th>
                    <th>Aktivní</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
            {foreach $tools as $tool}
                <tr>
                    <td><code>{$tool->name}</code></td>
                    <td class="text-secondary">{$tool->description}</td>
                    <td>
                        {if $tool->is_active}
                            <span class="badge bg-green">Ano</span>
                        {else}
                            <span class="badge bg-secondary">Ne</span>
                        {/if}
                    </td>
                    <td>
                        {if $isAdmin}
                            <form method="post" action="{plink toggle! id => $tool->id}" class="d-inline">
                                <input type="hidden" name="_csrf" value="{$presenter->getCsrfToken()}">
                                <button type="submit" n:class="btn, btn-sm, $tool->is_active ? btn-outline-warning : btn-outline-success"
                                        onclick="return confirm('{if $tool->is_active}Opravdu deaktivovat {$tool->name}?{else}Aktivovat {$tool->name}?{/if}')">
                                    {if $tool->is_active}Deaktivovat{else}Aktivovat{/if}
                                </button>
                            </form>
                        {/if}
                    </td>
                </tr>
            {else}
                <tr>
                    <td colspan="4" class="text-center text-secondary py-4">Žádné nástroje.</td>
                </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
