{block title}Nový scénář{/block}

{block breadcrumb}
<ol class="breadcrumb" aria-label="breadcrumbs">
    <li class="breadcrumb-item"><a href="{plink default}">Scénáře</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nový scénář</li>
</ol>
{/block}

{block content}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                {form scenarioForm}
                    <div class="mb-3">
                        <label class="form-label" for="{$form['name']->htmlId}">Identifikátor</label>
                        {input name, class => 'form-control'}
                        <small class="form-hint">Unikátní název bez mezer, např. <code>add_comment</code></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="{$form['description']->htmlId}">Popis</label>
                        {input description, class => 'form-control'}
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="{$form['input_schema']->htmlId}">Vstupní schéma (JSON Schema)</label>
                        {input input_schema}
                        <small class="form-hint">Definuje jaké parametry scénář přijímá od volajícího</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="{$form['steps']->htmlId}">Kroky</label>
                        <div class="mb-2 d-flex gap-2 align-items-center">
                            <select id="tool-picker" class="form-select form-select-sm" style="width: auto;">
                                <option value="">— Přidat krok —</option>
                                {foreach $availableTools as $tool}
                                    <option value="{$tool->name}" data-description="{$tool->description}">{$tool->name}</option>
                                {/foreach}
                                <optgroup label="Řízení">
                                    <option value="_condition">podmínka (condition)</option>
                                    <option value="_loop">cyklus (loop)</option>
                                </optgroup>
                            </select>
                            <button type="button" id="add-step-btn" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-plus me-1"></i>Přidat
                            </button>
                        </div>
                        {input steps}
                    </div>
                    <div class="mb-3">
                        {input is_active, class => 'form-check-input'}
                        <label class="form-check-label" for="{$form['is_active']->htmlId}">Aktivní</label>
                    </div>
                    {if $form->hasErrors()}
                        <div class="alert alert-danger">
                            {foreach $form->errors as $error}
                                <div>{$error}</div>
                            {/foreach}
                        </div>
                    {/if}
                    <div class="d-flex justify-content-end">
                        {input send, class => 'btn btn-primary'}
                    </div>
                {/form}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-info-circle me-1"></i>Nápověda</h3>
            </div>
            <div class="card-body">
                <h4 class="mb-2">Typy kroků</h4>
                <ul class="mb-3">
                    <li><code>tool</code> — spustí nástroj</li>
                    <li><code>condition</code> — větvení (if/then/else)</li>
                    <li><code>loop</code> — cyklus přes pole</li>
                </ul>
                <h4 class="mb-2">Template výrazy</h4>
                <ul class="mb-3">
                    <li><code n:syntax="off">{{input.project}}</code> — vstupní parametr</li>
                    <li><code n:syntax="off">{{step_id.output.field}}</code> — výstup předchozího kroku</li>
                </ul>
                <h4 class="mb-2">Příklad kroku</h4>
                <pre class="mb-0" n:syntax="off"><code>{
  "id": "project",
  "type": "tool",
  "tool": "pm_open_project",
  "input": {
    "query": "{{input.project}}"
  }
}</code></pre>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-tool me-1"></i>Dostupné nástroje</h3>
            </div>
            <div class="list-group list-group-flush">
                {foreach $availableTools as $tool}
                <div class="list-group-item list-group-item-action py-1 px-3 tool-insert-item" data-tool="{$tool->name}" style="cursor: pointer;">
                    <code class="small">{$tool->name}</code>
                    <div class="text-secondary small">{$tool->description}</div>
                </div>
                {/foreach}
            </div>
        </div>
    </div>
</div>

<script n:syntax="off">
(function() {
    var stepsField = document.querySelector('[name="steps"]');
    var picker = document.getElementById('tool-picker');
    var addBtn = document.getElementById('add-step-btn');
    var stepCounter = 0;

    // Templates for each step type
    var toolTemplates = {
        'pm_login': { input: {} },
        'pm_open_project': { input: { query: '{{input.project}}' } },
        'pm_open_task': { input: { query: '{{input.task}}' } },
        'pm_read_task': { input: {} },
        'pm_update_task': { input: { fields: {} } },
        'pm_close_task': { input: {} },
        'pm_create_comment': { input: { text: '{{input.text}}' } },
        'pm_search_comments': { input: { query: '' } },
        'pm_create_subtask': { input: { name: '{{input.subtask_name}}' } },
        'pm_search_subtasks': { input: { query: '' } },
        'pm_close_subtask': { input: { path_info: '' } },
        'pm_update_subtask': { input: { path_info: '', fields: {} } },
        'pm_time_track': { input: { hours: 0, date: '' } },
        'pm_export_csv': { input: { type: 'tasks' } },
    };

    function getSteps() {
        try {
            var parsed = JSON.parse(stepsField.value);
            if (Array.isArray(parsed)) return parsed;
        } catch (e) {}
        return [];
    }

    function setSteps(steps) {
        stepsField.value = JSON.stringify(steps, null, 2);
    }

    function makeStepId(toolName) {
        stepCounter++;
        var base = toolName.replace('pm_', '').replace(/_/g, '_');
        return base + (stepCounter > 1 ? '_' + stepCounter : '');
    }

    function addStep(toolName) {
        var steps = getSteps();

        if (toolName === '_condition') {
            steps.push({
                id: 'check_' + (++stepCounter),
                type: 'condition',
                'if': '{{step_id.output.count}} == 1',
                then: [],
                'else': []
            });
        } else if (toolName === '_loop') {
            steps.push({
                id: 'loop_' + (++stepCounter),
                type: 'loop',
                over: '{{input.items}}',
                as: 'item',
                steps: []
            });
        } else {
            var tmpl = toolTemplates[toolName] || { input: {} };
            steps.push({
                id: makeStepId(toolName),
                type: 'tool',
                tool: toolName,
                input: tmpl.input
            });
        }

        setSteps(steps);
        stepsField.scrollTop = stepsField.scrollHeight;
    }

    // Button click
    addBtn.addEventListener('click', function() {
        var val = picker.value;
        if (!val) return;
        addStep(val);
        picker.value = '';
    });

    // Click on tool in sidebar list
    document.querySelectorAll('.tool-insert-item').forEach(function(el) {
        el.addEventListener('click', function() {
            addStep(el.dataset.tool);
        });
    });

    // Init empty array if empty
    if (!stepsField.value.trim()) {
        setSteps([]);
    }

    // Count existing steps
    stepCounter = getSteps().length;
})();
</script>
{/block}
