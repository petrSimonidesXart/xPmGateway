{block title}Nový scénář{/block}

{block breadcrumb}
<ol class="breadcrumb" aria-label="breadcrumbs">
    <li class="breadcrumb-item"><a href="{plink default}">Scénáře</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nový scénář</li>
</ol>
{/block}

{block content}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                {form scenarioForm}
                    <div class="mb-3">
                        <label class="form-label" for="{$form['name']->htmlId}">Identifikátor</label>
                        {input name, class => 'form-control'}
                        <small class="form-hint">Unikátní název bez mezer, např. <code>add_comment</code></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="{$form['description']->htmlId}">Popis</label>
                        {input description, class => 'form-control'}
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kroky</label>
                        <div class="mb-2 d-flex gap-2 align-items-center">
                            <select id="tool-picker" class="form-select form-select-sm" style="width: auto;">
                                <option value="">— Přidat krok —</option>
                                {foreach $availableTools as $tool}
                                    <option value="{$tool->name}">{$tool->name} — {$tool->description}</option>
                                {/foreach}
                                <optgroup label="Řízení">
                                    <option value="_condition">podmínka (condition)</option>
                                    <option value="_loop">cyklus (loop)</option>
                                </optgroup>
                            </select>
                            <button type="button" id="add-step-btn" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-plus me-1"></i>Přidat
                            </button>
                        </div>
                        {input steps}
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Vstupní schéma
                            <span class="badge bg-blue-lt ms-1" id="schema-auto-badge">auto</span>
                        </label>
                        {input input_schema}
                        <small class="form-hint">Generuje se automaticky z proměnných v krocích. Můžete upravit popisy a typy.</small>
                    </div>
                    <div class="mb-3">
                        {input is_active, class => 'form-check-input'}
                        <label class="form-check-label" for="{$form['is_active']->htmlId}">Aktivní</label>
                    </div>
                    {if $form->hasErrors()}
                        <div class="alert alert-danger">
                            {foreach $form->errors as $error}
                                <div>{$error}</div>
                            {/foreach}
                        </div>
                    {/if}
                    <div class="d-flex justify-content-end">
                        {input send, class => 'btn btn-primary'}
                    </div>
                {/form}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-tool me-1"></i>Dostupné nástroje</h3>
            </div>
            <div class="list-group list-group-flush" style="max-height: 500px; overflow-y: auto;">
                {foreach $availableTools as $tool}
                <div class="list-group-item list-group-item-action py-1 px-3 tool-insert-item" data-tool="{$tool->name}" style="cursor: pointer;">
                    <code class="small">{$tool->name}</code>
                    <div class="text-secondary small">{$tool->description}</div>
                </div>
                {/foreach}
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-info-circle me-1"></i>Nápověda</h3>
            </div>
            <div class="card-body small">
                <p class="mb-2"><strong>Template výrazy:</strong></p>
                <ul class="mb-2">
                    <li><code n:syntax="off">{{input.nazev}}</code> — vstup od uživatele</li>
                    <li><code n:syntax="off">{{step_id.output.pole}}</code> — výstup kroku</li>
                </ul>
                <p class="mb-0 text-secondary">Proměnné <code n:syntax="off">{{input.*}}</code> se automaticky přidají do vstupního schématu.</p>
            </div>
        </div>
    </div>
</div>

<script n:syntax="off">
(function() {
    var stepsField = document.querySelector('[name="steps"]');
    var schemaField = document.querySelector('[name="input_schema"]');
    var picker = document.getElementById('tool-picker');
    var addBtn = document.getElementById('add-step-btn');
    var stepCounter = 0;

    // Tool input templates with descriptions for schema generation
    var toolTemplates = {
        'pm_login': { input: {} },
        'pm_open_project': { input: { query: '{{input.project}}' }, vars: { project: { type: 'string', description: 'Název projektu' } } },
        'pm_open_task': { input: { query: '{{input.task}}' }, vars: { task: { type: 'string', description: 'Název úkolu' } } },
        'pm_read_task': { input: {} },
        'pm_update_task': { input: { fields: {} } },
        'pm_close_task': { input: {} },
        'pm_create_comment': { input: { text: '{{input.text}}' }, vars: { text: { type: 'string', description: 'Text komentáře' } } },
        'pm_search_comments': { input: { query: '{{input.search_query}}' }, vars: { search_query: { type: 'string', description: 'Hledaný text' } } },
        'pm_create_subtask': { input: { name: '{{input.subtask_name}}', assignee: '{{input.subtask_assignee}}', label: '{{input.subtask_label}}', schedule: '{{input.subtask_schedule}}', estimate: '{{input.subtask_estimate}}' }, vars: { subtask_name: { type: 'string', description: 'Název podúkolu' }, subtask_assignee: { type: 'string', description: 'Zodpovědná osoba' }, subtask_label: { type: 'string', description: 'Štítek (Řešit, Schůzka, ...)' }, subtask_schedule: { type: 'string', description: 'Plánování: this_week, next_week, after_next_week, nebo YYYY/MM/DD' }, subtask_estimate: { type: 'string', description: 'Časový odhad (1 = hodina, :30 = 30min)' } } },
        'pm_search_subtasks': { input: { query: '{{input.search_query}}' } },
        'pm_close_subtask': { input: { path_info: '' } },
        'pm_update_subtask': { input: { path_info: '', fields: {} } },
        'pm_time_track': { input: { hours: '{{input.hours}}', date: '{{input.date}}' }, vars: { hours: { type: 'number', description: 'Počet hodin' }, date: { type: 'string', description: 'Datum (YYYY/MM/DD)' } } },
        'pm_export_csv': { input: { type: 'tasks' } },
    };

    function getSteps() {
        try { var p = JSON.parse(stepsField.value); if (Array.isArray(p)) return p; } catch (e) {}
        return [];
    }

    function setSteps(steps) {
        // Ensure empty inputs are {} not []
        steps.forEach(function(s) {
            if (s.input && Array.isArray(s.input) && s.input.length === 0) s.input = {};
        });
        stepsField.value = JSON.stringify(steps, null, 2);
        syncSchema();
    }

    function makeStepId(toolName) {
        stepCounter++;
        var base = toolName.replace('pm_', '');
        return base + (stepCounter > 1 ? '_' + stepCounter : '');
    }

    function addStep(toolName) {
        var steps = getSteps();
        if (toolName === '_condition') {
            steps.push({ id: 'check_' + (++stepCounter), type: 'condition', 'if': '{{step_id.output.count}} == 1', then: [], 'else': [] });
        } else if (toolName === '_loop') {
            steps.push({ id: 'loop_' + (++stepCounter), type: 'loop', over: '{{input.items}}', as: 'item', steps: [] });
        } else {
            var tmpl = toolTemplates[toolName] || { input: {} };
            steps.push({ id: makeStepId(toolName), type: 'tool', tool: toolName, input: JSON.parse(JSON.stringify(tmpl.input)) });
        }
        setSteps(steps);
        stepsField.scrollTop = stepsField.scrollHeight;
    }

    // Extract all {{input.xxx}} variables from steps JSON and build schema
    function syncSchema() {
        var stepsJson = stepsField.value;
        var varNames = {};

        // Find all {{input.xxx}} references
        var regex = /\{\{input\.([a-zA-Z0-9_]+)\}\}/g;
        var match;
        while ((match = regex.exec(stepsJson)) !== null) {
            var varName = match[1];
            if (!varNames[varName]) {
                varNames[varName] = { type: 'string', description: '' };
            }
        }

        // Enrich with known descriptions from tool templates
        for (var toolName in toolTemplates) {
            var tmpl = toolTemplates[toolName];
            if (tmpl.vars) {
                for (var v in tmpl.vars) {
                    if (varNames[v] && !varNames[v].description) {
                        varNames[v] = tmpl.vars[v];
                    }
                }
            }
        }

        // Check current schema — preserve user edits if they exist
        var currentSchema;
        try { currentSchema = JSON.parse(schemaField.value); } catch (e) { currentSchema = null; }

        // Preserve existing descriptions/types from current schema
        if (currentSchema && currentSchema.properties) {
            for (var key in varNames) {
                if (currentSchema.properties[key]) {
                    if (currentSchema.properties[key].description) {
                        varNames[key].description = currentSchema.properties[key].description;
                    }
                    if (currentSchema.properties[key].type) {
                        varNames[key].type = currentSchema.properties[key].type;
                    }
                }
            }
        }

        var required = Object.keys(varNames);
        var properties = {};
        for (var name in varNames) {
            properties[name] = { type: varNames[name].type, minLength: 1, description: varNames[name].description };
            if (varNames[name].type === 'number') {
                delete properties[name].minLength;
            }
        }

        var schema = {
            type: 'object',
            required: required,
            properties: properties,
            additionalProperties: false
        };

        schemaField.value = JSON.stringify(schema, null, 2);
    }

    // Listen for manual edits to steps field
    stepsField.addEventListener('input', function() {
        syncSchema();
    });

    addBtn.addEventListener('click', function() { var v = picker.value; if (!v) return; addStep(v); picker.value = ''; });
    document.querySelectorAll('.tool-insert-item').forEach(function(el) {
        el.addEventListener('click', function() { addStep(el.dataset.tool); });
    });

    // Init
    if (!stepsField.value.trim()) {
        setSteps([]);
    }
    stepCounter = getSteps().length;

    if (!schemaField.value.trim() || schemaField.value.trim() === '{}') {
        syncSchema();
    }
})();
</script>
{/block}
