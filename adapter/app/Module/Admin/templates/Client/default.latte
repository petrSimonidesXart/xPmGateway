{block title}Klienti{/block}

{block actions}
{if $isAdmin}
<a href="{plink create}" class="btn btn-primary">
    <i class="ti ti-plus me-1"></i>Nový klient
</a>
{/if}
{/block}

{block content}
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Service Account</th>
                    <th>Aktivní</th>
                    <th>Vytvořen</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
            {foreach $clients as $client}
                <tr>
                    <td><a href="{plink detail $client->id}">{$client->name}</a></td>
                    <td class="text-secondary">{$client->ref('service_accounts', 'service_account_id')?->name}</td>
                    <td>
                        {if $client->is_active}
                            <span class="badge bg-green">Ano</span>
                        {else}
                            <span class="badge bg-secondary">Ne</span>
                        {/if}
                    </td>
                    <td class="text-secondary">{$client->created_at|date:'d.m.Y'}</td>
                    <td>
                        {if $isAdmin}
                            <div class="btn-list">
                                <a href="{plink edit $client->id}" class="btn btn-sm btn-outline-secondary">Upravit</a>
                                <a href="{plink :Admin:Token:default $client->id}" class="btn btn-sm btn-outline-secondary">
                                    <i class="ti ti-key me-1"></i>Tokeny
                                </a>
                            </div>
                        {/if}
                    </td>
                </tr>
            {else}
                <tr>
                    <td colspan="5" class="text-center text-secondary py-4">Žádní klienti.</td>
                </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
