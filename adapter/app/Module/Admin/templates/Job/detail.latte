{block title}Úloha {$job->id|truncate(12, '…')}{/block}

{block breadcrumb}
<ol class="breadcrumb" aria-label="breadcrumbs">
    <li class="breadcrumb-item"><a href="{plink default}">Úlohy</a></li>
    <li class="breadcrumb-item active" aria-current="page"><code title="{$job->id}">{$job->id|truncate(12, '…')}</code></li>
</ol>
{/block}

{block actions}
{if in_array($job->status, ['pending', 'processing'])}
<form method="post" action="{plink cancel! id => $job->id}" class="d-inline me-2">
    <input type="hidden" name="_csrf" value="{$presenter->getCsrfToken()}">
    <button type="submit" class="btn btn-outline-danger" data-confirm="Opravdu zrušit tuto úlohu?">
        <i class="ti ti-x me-1"></i>Zrušit
    </button>
</form>
{/if}
{if in_array($job->status, ['failed', 'timeout'])}
<form method="post" action="{plink retry! id => $job->id}" class="d-inline me-2">
    <input type="hidden" name="_csrf" value="{$presenter->getCsrfToken()}">
    <button type="submit" class="btn btn-outline-warning">
        <i class="ti ti-refresh me-1"></i>Opakovat úlohu
    </button>
</form>
{/if}
<a href="{plink default}" class="btn btn-outline-secondary">
    <i class="ti ti-arrow-left me-1"></i>Zpět na seznam
</a>
{/block}

{block content}
<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informace o úloze</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Job ID</div>
                        <div class="datagrid-content"><code>{$job->id}</code></div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Nástroj</div>
                        <div class="datagrid-content">{$job->ref('tools', 'tool_id')?->name}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Klient</div>
                        <div class="datagrid-content">{$job->ref('clients', 'client_id')?->name}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Status</div>
                        <div class="datagrid-content"><span class="badge badge-{$job->status}">{$job->status}</span></div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Pokusů</div>
                        <div class="datagrid-content">{$job->attempts}/{$job->max_attempts}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Vytvořen</div>
                        <div class="datagrid-content">{$job->created_at|date:'d.m.Y H:i:s'}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Zahájen</div>
                        <div class="datagrid-content">{if $job->started_at}{$job->started_at|date:'d.m.Y H:i:s'}{else}—{/if}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Dokončen</div>
                        <div class="datagrid-content">{if $job->finished_at}{$job->finished_at|date:'d.m.Y H:i:s'}{else}—{/if}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Trvání</div>
                        <div class="datagrid-content">{if $duration !== null}{$duration} s{else}—{/if}</div>
                    </div>
                    {if $retryOf}
                    <div class="datagrid-item">
                        <div class="datagrid-title">Opakování úlohy</div>
                        <div class="datagrid-content">
                            <a href="{plink detail $retryOf->id}"><i class="ti ti-arrow-back-up me-1"></i><code title="{$retryOf->id}">{$retryOf->id|truncate(12, '…')}</code></a>
                            <span class="badge badge-{$retryOf->status} ms-1">{$retryOf->status}</span>
                        </div>
                    </div>
                    {/if}
                    {if $retriedAs}
                    <div class="datagrid-item">
                        <div class="datagrid-title">Opakován jako</div>
                        <div class="datagrid-content">
                            <a href="{plink detail $retriedAs->id}"><i class="ti ti-refresh me-1"></i><code title="{$retriedAs->id}">{$retriedAs->id|truncate(12, '…')}</code></a>
                            <span class="badge badge-{$retriedAs->status} ms-1">{$retriedAs->status}</span>
                        </div>
                    </div>
                    {/if}
                    {if $continuedFrom}
                    <div class="datagrid-item">
                        <div class="datagrid-title">Pokračování úlohy</div>
                        <div class="datagrid-content">
                            <a href="{plink detail $continuedFrom->id}"><i class="ti ti-arrow-forward-up me-1 text-purple"></i><code title="{$continuedFrom->id}">{$continuedFrom->id|truncate(12, '…')}</code></a>
                            <span class="badge badge-{$continuedFrom->status} ms-1">{$continuedFrom->status}</span>
                        </div>
                    </div>
                    {/if}
                    {if $continuedAs}
                    <div class="datagrid-item">
                        <div class="datagrid-title">Pokračuje jako</div>
                        <div class="datagrid-content">
                            <a href="{plink detail $continuedAs->id}"><i class="ti ti-arrow-forward me-1 text-purple"></i><code title="{$continuedAs->id}">{$continuedAs->id|truncate(12, '…')}</code></a>
                            <span class="badge badge-{$continuedAs->status} ms-1">{$continuedAs->status}</span>
                        </div>
                    </div>
                    {/if}
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Payload</h3>
            </div>
            <div class="card-body">
                <pre class="mb-0 pre-scroll"><code>{$job->payload}</code></pre>
            </div>
        </div>
    </div>
    <div class="col-12 {if !$job->step_results}d-none{/if}" id="progress-card">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-list-check me-1"></i>Průběh
                    <span class="spinner-border spinner-border-sm ms-2 d-none" id="progress-spinner"></span>
                </h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-sm">
                    <thead>
                        <tr>
                            <th class="w-1">#</th>
                            <th>Zpráva</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="progress-body">
                    {if $job->step_results}
                    {foreach json_decode($job->step_results, true) as $i => $step}
                        <tr>
                            <td class="text-secondary">{$i + 1}</td>
                            <td>
                                {if isset($step['output']['message'])}
                                    {$step['output']['message']}
                                {elseif isset($step['tool'])}
                                    <code>{$step['tool']}</code>
                                    {if isset($step['error'])}
                                        <span class="text-danger ms-2">{$step['error']}</span>
                                    {/if}
                                {else}
                                    {$step['id']}
                                {/if}
                            </td>
                            <td>
                                {if ($step['status'] ?? '') === 'success'}
                                    <span class="badge badge-success">OK</span>
                                {elseif ($step['status'] ?? '') === 'failed'}
                                    <span class="badge badge-failed">Chyba</span>
                                {else}
                                    <span class="badge bg-secondary">{$step['status'] ?? '?'}</span>
                                {/if}
                            </td>
                        </tr>
                    {/foreach}
                    {/if}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {if $job->status === 'awaiting_input' && $job->awaiting_input_context}
    {var $awCtx = json_decode($job->awaiting_input_context, true)}
    <div class="col-12">
        <div class="card border-purple">
            <div class="card-header bg-purple text-white">
                <h3 class="card-title text-white">
                    <i class="ti ti-help me-1"></i>Čeká na vstup
                </h3>
            </div>
            <div class="card-body">
                <p class="mb-3">{$awCtx['input_prompt'] ?? 'Vyberte z možností:'}</p>
                <div class="list-group">
                    {foreach $awCtx['options'] ?? [] as $option}
                    <form method="post" action="{plink retry! id => $job->id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <input type="hidden" name="_csrf" value="{$presenter->getCsrfToken()}">
                        <input type="hidden" name="selected_path_info" value="{$option['path_info'] ?? ''}">
                        <div>
                            <strong>{$option['name'] ?? '?'}</strong>
                            {if isset($option['path_info'])}
                                <small class="text-secondary ms-2"><code>{$option['path_info']}</code></small>
                            {/if}
                        </div>
                        <button type="submit" class="btn btn-sm btn-purple">
                            <i class="ti ti-check me-1"></i>Vybrat
                        </button>
                    </form>
                    {/foreach}
                </div>
            </div>
        </div>
    </div>
    {/if}
    {if $job->result && $job->status !== 'awaiting_input'}
    {var $resultData = json_decode($job->result, true)}
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <h3 class="card-title">Výsledek</h3>
                <button class="btn btn-sm btn-ghost-secondary ms-auto" onclick="var j=document.getElementById('result-json'),t=document.getElementById('result-table');j.classList.toggle('d-none');t.classList.toggle('d-none');">
                    <i class="ti ti-code me-1"></i>JSON
                </button>
            </div>
            <div id="result-table">
                {if is_array($resultData)}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-sm">
                        <tbody>
                        {foreach $resultData as $key => $value}
                            {continueIf $key === '_progress' || $key === 'options'}
                            <tr>
                                <td class="text-secondary fw-bold" style="width: 180px;">{$key}</td>
                                <td>
                                    {if is_bool($value)}
                                        {if $value}<span class="badge bg-green">true</span>{else}<span class="badge bg-secondary">false</span>{/if}
                                    {elseif is_null($value)}
                                        <span class="text-secondary">—</span>
                                    {elseif is_array($value)}
                                        <pre class="mb-0 pre-scroll" style="max-height: 200px;"><code>{$value|json_encode(\JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE)}</code></pre>
                                    {else}
                                        {$value}
                                    {/if}
                                </td>
                            </tr>
                        {/foreach}
                        </tbody>
                    </table>
                </div>
                {else}
                <div class="card-body">
                    <pre class="mb-0 pre-scroll"><code>{$job->result}</code></pre>
                </div>
                {/if}
            </div>
            <div id="result-json" class="card-body d-none">
                <pre class="mb-0 pre-scroll"><code>{$job->result}</code></pre>
            </div>
        </div>
    </div>
    {/if}
    {if $job->error_message}
    <div class="col-12">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title text-white">
                    <i class="ti ti-alert-circle me-1"></i>Chyba
                </h3>
            </div>
            <div class="card-body">
                <pre class="mb-0 pre-scroll text-danger"><code>{$job->error_message}</code></pre>
            </div>
        </div>
    </div>
    {/if}
    {if $artifacts}
    {var $videoArtifacts = array_filter($artifacts, fn($a) => str_starts_with($a->mime_type, 'video/'))}
    {var $otherArtifacts = array_filter($artifacts, fn($a) => !str_starts_with($a->mime_type, 'video/'))}
    {if $videoArtifacts}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-video me-1"></i>Video záznam</h3>
            </div>
            <div class="card-body">
                {foreach $videoArtifacts as $artifact}
                <video controls class="w-100 rounded" style="max-height: 480px; background: #000;">
                    <source src="{plink artifactView $artifact->id}" type="{$artifact->mime_type}">
                </video>
                <div class="mt-2 text-secondary small">
                    {$artifact->filename} · {=$artifact->size_bytes / 1024|number:1} KB
                    · <a href="{plink artifactDownload $artifact->id}"><i class="ti ti-download me-1"></i>Stáhnout</a>
                </div>
                {/foreach}
            </div>
        </div>
    </div>
    {/if}
    {if $otherArtifacts}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-files me-1"></i>Artefakty</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Soubor</th>
                            <th>Typ</th>
                            <th>Velikost</th>
                            <th>Vytvořen</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                    {foreach $otherArtifacts as $artifact}
                        <tr>
                            <td><i class="ti ti-file me-1"></i>{$artifact->filename}</td>
                            <td class="text-secondary">{$artifact->mime_type}</td>
                            <td class="text-secondary">{=$artifact->size_bytes / 1024|number:1} KB</td>
                            <td class="text-secondary">{$artifact->created_at|date:'d.m.Y H:i:s'}</td>
                            <td>
                                <a href="{plink artifactDownload $artifact->id}" class="btn btn-sm btn-outline-primary">
                                    <i class="ti ti-download me-1"></i>Stáhnout
                                </a>
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {/if}
    {/if}
    {if $screenshots}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Screenshoty</h3>
            </div>
            <div class="card-body">
                <div class="row row-cards">
                    {foreach $screenshots as $screenshot}
                        <div class="col-sm-6 col-md-4 col-xl-3">
                            <a href="{plink screenshot $job->id, $screenshot['file']}" target="_blank" class="d-block">
                                <div class="card">
                                    <img src="{plink screenshot $job->id, $screenshot['file']}" class="card-img-top" alt="{$screenshot['step']}">
                                    <div class="card-body p-2">
                                        <small class="text-secondary">{$screenshot['step']}</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {/foreach}
                </div>
            </div>
        </div>
    </div>
    {/if}
</div>

{if in_array($job->status, ['pending', 'processing'])}
<div id="progress-poll-config" class="d-none" data-url="{plink progress $job->id}"></div>
<script n:syntax="off">
(function() {
    var POLL_URL = document.getElementById('progress-poll-config').dataset.url;
    var body = document.getElementById('progress-body');
    var card = document.getElementById('progress-card');
    var spinner = document.getElementById('progress-spinner');
    var prevCount = 0;
    var stopped = false;

    function badgeHtml(status) {
        if (status === 'success') return '<span class="badge badge-success">OK</span>';
        if (status === 'failed') return '<span class="badge badge-failed">Chyba</span>';
        return '<span class="badge bg-secondary">' + (status || '?') + '</span>';
    }

    function renderSteps(steps) {
        if (!steps || !steps.length) return;
        card.classList.remove('d-none');
        spinner.classList.remove('d-none');

        var html = '';
        for (var i = 0; i < steps.length; i++) {
            var s = steps[i];
            var msg = '';
            if (s.output && s.output.message) {
                msg = s.output.message;
            } else if (s.tool) {
                msg = '<code>' + s.tool + '</code>';
                if (s.error) msg += ' <span class="text-danger ms-2">' + s.error + '</span>';
            } else {
                msg = s.id || '';
            }
            html += '<tr><td class="text-secondary">' + (i+1) + '</td>';
            html += '<td>' + msg + '</td>';
            html += '<td>' + badgeHtml(s.status) + '</td></tr>';
        }
        body.innerHTML = html;

        if (steps.length > prevCount) {
            // Scroll the new row into view
            var lastRow = body.lastElementChild;
            if (lastRow) lastRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        prevCount = steps.length;
    }

    async function poll() {
        if (stopped) return;
        try {
            var res = await fetch(POLL_URL);
            if (!res.ok) return;
            var data = await res.json();

            if (data.step_results) {
                renderSteps(data.step_results);
            }

            // Stop polling when job is done
            if (data.status !== 'pending' && data.status !== 'processing') {
                stopped = true;
                spinner.classList.add('d-none');
                // Reload page to show full result, artifacts, video
                setTimeout(function() { window.location.reload(); }, 1500);
                return;
            }
        } catch (e) { /* ignore */ }
    }

    setInterval(poll, 2000);
    poll();
})();
</script>
{/if}
{/block}
