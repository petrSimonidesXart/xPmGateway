{block title}Service Accounts{/block}

{block actions}
{if $isAdmin}
<a href="{plink create}" class="btn btn-primary">
    <i class="ti ti-plus me-1"></i>Nový account
</a>
{/if}
{/block}

{block content}
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Username</th>
                    <th>Aktivní</th>
                    <th>Vytvořen</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
            {foreach $accounts as $account}
                <tr>
                    <td>{$account->name}</td>
                    <td class="text-secondary">{$account->username}</td>
                    <td>
                        {if $account->is_active}
                            <span class="badge bg-green">Ano</span>
                        {else}
                            <span class="badge bg-secondary">Ne</span>
                        {/if}
                    </td>
                    <td class="text-secondary">{$account->created_at|date:'d.m.Y'}</td>
                    <td>
                        {if $isAdmin}
                            <div class="btn-list">
                                <a href="{plink edit $account->id}" class="btn btn-sm btn-outline-secondary">Upravit</a>
                                <form method="post" action="{plink delete! $account->id}" class="d-inline">
                                    <input type="hidden" name="_csrf" value="{$presenter->getCsrfToken()}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm="Opravdu smazat service account {$account->name}?">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </div>
                        {/if}
                    </td>
                </tr>
            {else}
                <tr>
                    <td colspan="5" class="text-center text-secondary py-4">Žádné service accounts.</td>
                </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
