{
    "name": "xpm/gateway-adapter",
    "description": "PM Gateway Adapter - MCP Gateway + Admin UI",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/di": "^3.2",
        "nette/http": "^3.2",
        "nette/security": "^3.2",
        "nette/forms": "^3.2",
        "nette/database": "^3.2",
        "nette/caching": "^3.2",
        "nette/utils": "^4.0",
        "nette/schema": "^1.3",
        "nette/mail": "^4.0",
        "latte/latte": "^3.0",
        "tracy/tracy": "^2.10",
        "contributte/console": "^0.9",
        "opis/json-schema": "^2.3",
        "robmorgan/phinx": "^0.16.11"
    },
    "require-dev": {
        "nette/tester": "^2.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-nette": "^2.0",
        "nette/coding-standard": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "tester tests -C",
        "phpstan": "phpstan analyse --no-progress",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@test",
            "@phpstan",
            "@cs-check"
        ],
        "migrate": "phinx migrate -c phinx.php",
        "migrate:status": "phinx status -c phinx.php",
        "migrate:rollback": "phinx rollback -c phinx.php",
        "seed": "phinx seed:run -c phinx.php"
    },
    "config": {
        "allow-plugins": {
            "nette/component-model": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
