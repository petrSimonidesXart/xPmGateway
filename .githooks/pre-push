#!/bin/bash
# pre-push dispatcher — executes hooks from core/ then project/
# Install: .gaai/project/scripts/install-hooks.sh
#
# Note: git sends push info on stdin. We capture it once and replay
# it to each script so multiple scripts can inspect the same data.

ROOT="$(git rev-parse --show-toplevel)"
CORE_DIR="$ROOT/.gaai/core/hooks/pre-push.d"
PROJECT_DIR="$ROOT/.gaai/project/hooks/pre-push.d"

PUSH_INFO="$(cat)"

for dir in "$CORE_DIR" "$PROJECT_DIR"; do
    [ -d "$dir" ] || continue
    for script in "$dir"/*; do
        [ -x "$script" ] || continue
        echo "$PUSH_INFO" | "$script" "$@" || exit $?
    done
done

exit 0

# ── GAAI dispatcher ──
# Delegate to GAAI hook scripts in .gaai/core/hooks/pre-push.d/
# and .gaai/project/hooks/pre-push.d/ (added by install.sh)
ROOT="$(git rev-parse --show-toplevel)"
for _gaai_dir in "$ROOT/.gaai/core/hooks/pre-push.d" "$ROOT/.gaai/project/hooks/pre-push.d"; do
    [ -d "$_gaai_dir" ] || continue
    for _gaai_script in "$_gaai_dir"/*; do
        [ -x "$_gaai_script" ] || continue
        "$_gaai_script" "$@" || exit $?
    done
done
